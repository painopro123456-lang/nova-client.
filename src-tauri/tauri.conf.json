{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Client",
  "version": "0.1.0",
  "identifier": "com.nova.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOVA Client",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.modrinth.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Game",
    "shortDescription": "A modern Minecraft Java launcher",
    "longDescription": "NOVA Client is a Windows-first Minecraft Java launcher."
  }
}
